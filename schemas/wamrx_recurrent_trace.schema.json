{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wamrx://schemas/recurrent-trace/v1",
  "title": "WAM-RX recurrent reasoning trace v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "interface_version",
    "trace_id",
    "arm_id",
    "task_id",
    "problem_hash",
    "evidence_bundle_hash",
    "evidence_view_ids",
    "initial_high_state_hash",
    "budget",
    "maximum_answer_instability",
    "steps"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "interface_version": {"const": "wamrx-recurrent-interface-v1"},
    "trace_id": {"type": "string", "minLength": 1},
    "arm_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "problem_hash": {"type": "string", "minLength": 1},
    "evidence_bundle_hash": {"type": "string", "minLength": 1},
    "evidence_view_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "initial_high_state_hash": {"type": "string", "minLength": 1},
    "maximum_answer_instability": {"type": "number", "minimum": 0, "maximum": 1},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_inference_flops",
        "maximum_macro_steps",
        "maximum_micro_steps_per_macro",
        "maximum_total_micro_steps",
        "maximum_retrieval_calls",
        "maximum_tool_calls"
      ],
      "properties": {
        "maximum_inference_flops": {"type": "integer", "minimum": 1},
        "maximum_macro_steps": {"type": "integer", "minimum": 1},
        "maximum_micro_steps_per_macro": {"type": "integer", "minimum": 1},
        "maximum_total_micro_steps": {"type": "integer", "minimum": 1},
        "maximum_retrieval_calls": {"type": "integer", "minimum": 0},
        "maximum_tool_calls": {"type": "integer", "minimum": 0}
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "macro_step",
          "micro_step",
          "high_state_in_hash",
          "high_state_out_hash",
          "low_state_hash",
          "injected_problem_hash",
          "injected_evidence_bundle_hash",
          "revalidated_view_ids",
          "learned_decision",
          "residual",
          "halt_decision",
          "operations",
          "flop_delta",
          "remaining_flops",
          "remaining_macro_steps"
        ],
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "macro_step": {"type": "integer", "minimum": 1},
          "micro_step": {"type": "integer", "minimum": 1},
          "high_state_in_hash": {"type": "string", "minLength": 1},
          "high_state_out_hash": {"type": "string", "minLength": 1},
          "low_state_hash": {"type": "string", "minLength": 1},
          "injected_problem_hash": {"type": "string", "minLength": 1},
          "injected_evidence_bundle_hash": {"type": "string", "minLength": 1},
          "revalidated_view_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "learned_decision": {"enum": ["continue", "stop"]},
          "halt_decision": {
            "enum": ["continue", "resolved", "resolved_at_budget", "unresolved_budget"]
          },
          "flop_delta": {"type": "integer", "minimum": 0},
          "remaining_flops": {"type": "integer", "minimum": 0},
          "remaining_macro_steps": {"type": "integer", "minimum": 0},
          "residual": {
            "type": "object",
            "required": [
              "unanswered_constraints",
              "missing_evidence",
              "conflicting_evidence",
              "unsatisfied_tool_postconditions",
              "answer_instability"
            ]
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "operation_id",
                "operation_type",
                "request",
                "journal_id",
                "supporting_event_ids"
              ]
            }
          }
        }
      }
    }
  }
}
