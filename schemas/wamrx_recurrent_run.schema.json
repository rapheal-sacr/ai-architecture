{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wamrx://schemas/recurrent-run-accounting/v1",
  "title": "WAM-RX registered recurrent run compute accounting",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "arm_id",
    "seed",
    "status",
    "counting_method",
    "parameter_count",
    "schedule_hash",
    "estimated_training_flops",
    "realized_training_flops",
    "estimated_inference_flops",
    "realized_inference_flops",
    "training_examples_planned",
    "training_examples_seen",
    "optimizer_updates_planned",
    "optimizer_updates_completed",
    "evaluation_examples_planned",
    "evaluation_examples_completed",
    "retrieval_calls",
    "tool_calls"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "arm_id": {"enum": ["fixed-depth-v1", "flat-recurrent-v1", "hierarchical-recurrent-v1"]},
    "seed": {"type": "integer", "minimum": 0},
    "status": {"enum": ["NOT_RUN", "INCOMPLETE", "INVALID", "COMPLETE"]},
    "counting_method": {"const": "wamrx-analytical-flops-v2"},
    "parameter_count": {"type": "integer", "minimum": 1},
    "schedule_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "estimated_training_flops": {"type": "integer", "minimum": 0},
    "realized_training_flops": {"type": "integer", "minimum": 0},
    "estimated_inference_flops": {"type": "integer", "minimum": 0},
    "realized_inference_flops": {"type": "integer", "minimum": 0},
    "training_examples_planned": {"type": "integer", "minimum": 0},
    "training_examples_seen": {"type": "integer", "minimum": 0},
    "optimizer_updates_planned": {"type": "integer", "minimum": 0},
    "optimizer_updates_completed": {"type": "integer", "minimum": 0},
    "evaluation_examples_planned": {"type": "integer", "minimum": 0},
    "evaluation_examples_completed": {"type": "integer", "minimum": 0},
    "retrieval_calls": {"type": "integer", "minimum": 0},
    "tool_calls": {"type": "integer", "minimum": 0}
  }
}
